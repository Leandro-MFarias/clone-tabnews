{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "JWT_SECRET",
            "patterns": ["/JWT_SECRET\\s*=\\s*.+/"],
            "message": "JWT_SECRET não pode ser commitado com valor preenchido"
          }
        ]
      }
    }
  ]
}
